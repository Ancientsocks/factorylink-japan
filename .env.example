# Local development values only. Replace all credentials and secrets before any deployment.
ENVIRONMENT=development
LOG_LEVEL=INFO
POSTGRES_DB=factorylink
POSTGRES_USER=factorylink
POSTGRES_PASSWORD=factorylink_local
# Restricted DML-only account used by API and Celery; migrations use POSTGRES_USER.
RUNTIME_DB_USER=factorylink_app
RUNTIME_DB_PASSWORD=factorylink_runtime_local
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=14
APP_PORT=8080
# Optional internal Python package mirror; default is the official PyPI index.
PIP_INDEX_URL=https://pypi.org/simple
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
SEED_DEMO_DATA=true
ALLOW_PUBLIC_REGISTRATION=true
# Local UI only. Render/production Docker builds default this to false.
VITE_FACTORYLINK_PUBLIC_REGISTRATION=true

# Transactional email (SMTP). Leave blank for local development action links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=FactoryLink <no-reply@factorylink.local>
SMTP_STARTTLS=true
# Optional HTTPS email delivery; takes precedence over SMTP when set. RESEND_FROM must use a verified sender.
RESEND_API_KEY=
RESEND_FROM=

# Google sign-in (optional). Leave blank to hide the Google button.
# The authorised redirect URI in Google Cloud must exactly match GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback

# Nace Drex decision support (optional). Failed quality inspections are routed to
# a team using the calibrated probability of each option. Leave the key empty to disable.
NACE_API_KEY=
NACE_MODEL=drex-latest

# Verification codes for sign-up and password reset are emailed, so configure
# SMTP or Resend before testing those flows; without either the API reports
# that no email was sent and (development only) returns the code to the UI.
FRONTEND_BASE_URL=http://localhost:8080
EXPOSE_AUTH_ACTION_LINKS=true
# In production: set EXPOSE_AUTH_ACTION_LINKS=false, ALLOW_PUBLIC_REGISTRATION=false,
# SEED_DEMO_DATA=false, ENVIRONMENT=production and configure real SMTP credentials.

# Document storage: local for development; private S3 bucket for production.
STORAGE_PROVIDER=local
UPLOAD_DIR=./data/uploads
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=ap-northeast-1
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# Malware scanning. Local direct development may disable this; Docker Compose starts
# a private ClamAV service and enables scanning by default. Production must enable it.
MALWARE_SCAN_ENABLED=true
MALWARE_SCANNER_HOST=clamav
MALWARE_SCANNER_PORT=3310
MALWARE_SCANNER_TIMEOUT_SECONDS=30
