# Copy to .env.production and restrict file access. Replace every placeholder.
# Prefer a managed secret store over a long-lived plaintext environment file.
FRONTEND_DOMAIN=factory.example.jp
ACME_EMAIL=operations@example.jp

# These are PostgreSQL URLs with sslmode=verify-full and a trusted CA configured.
# PG_ADMIN_URL is consumed by psql; the migration URL is SQLAlchemy/psycopg.
PG_ADMIN_URL=postgresql://migration_owner:REPLACE_ME@db.example.jp:5432/factorylink?sslmode=verify-full
DATABASE_OWNER_ROLE=migration_owner
MIGRATION_DATABASE_URL=postgresql+psycopg://migration_owner:REPLACE_ME@db.example.jp:5432/factorylink?sslmode=verify-full
RUNTIME_DB_USER=factorylink_app
RUNTIME_DB_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_SECRET
RUNTIME_DATABASE_URL=postgresql+psycopg://factorylink_app:REPLACE_ME@db.example.jp:5432/factorylink?sslmode=verify-full

# Generate at least 32 random bytes. Redis password should use URL-safe hex.
JWT_SECRET_KEY=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_BYTES
REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX_SECRET

SMTP_HOST=smtp.example.jp
SMTP_PORT=587
SMTP_USERNAME=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM=FactoryLink <no-reply@example.jp>

API_RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
REGISTRATION_RATE_LIMIT_PER_MINUTE=5
PASSWORD_RESET_RATE_LIMIT_PER_MINUTE=3

# Replace both paths with protected deployment files before starting Compose.
BACKUP_ENV_FILE=./deploy/production/backup-env.example
BACKUP_CA_FILE=./deploy/production/postgres-ca.example.pem
BACKUP_CRON_SCHEDULE=15 1 * * *

STORAGE_S3_BUCKET=factorylink-private-production
STORAGE_S3_REGION=ap-northeast-1
# Prefer an instance/task role; set both access key fields only if required.
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_ENDPOINT_URL=

LOG_LEVEL=INFO
